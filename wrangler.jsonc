{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anantawebsite",
  "compatibility_date": "2026-11-24",
  "routes": [
    {
      "pattern": "anantasilicon.com/*",
      "zone_name": "anantasilicon.com"
    },
    {
      "pattern": "www.anantasilicon.com/*",
      "zone_name": "anantasilicon.com"
    }
  ],
  "assets": {
    "directory": "./public/"
  },
  "observability": {
    "enabled": true
  }
}
