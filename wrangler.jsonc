{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "anantawebsite",
  "compatibility_date": "2026-11-24",
  "routes": [
    {
      "pattern": "anantasilicon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.anantasilicon.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public/"
  },
  "observability": {
    "enabled": true
  }
}
